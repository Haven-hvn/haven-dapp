    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@reown/appkit": "2.0.0-wagmi-3.0",
    "@reown/appkit-adapter-wagmi": "2.0.0-wagmi-3.0",
