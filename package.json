{
  "name": "haven-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true next build --webpack",
    "export": "next build --webpack",
    "build:prod": "next build --webpack",
    "preview": "next start",
    "clean": "rm -rf .next out",
    "deploy": "npx pinme@2.0.12 upload ./out",
    "deploy:pinme": "npx pinme@2.0.12 upload ./out",
    "pinme:version": "npx pinme@2.0.12 --version",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:report": "playwright show-report",
    "test:install": "playwright install --with-deps",
    "test:web3": "cross-env INCLUDE_WEB3_TESTS=true playwright test --project=web3-chromium",
    "test:web3:headed": "cross-env INCLUDE_WEB3_TESTS=true playwright test --project=web3-chromium --headed",
    "test:web3:ui": "cross-env INCLUDE_WEB3_TESTS=true playwright test --project=web3-chromium --ui",
    "test:all": "cross-env INCLUDE_WEB3_TESTS=true playwright test",
    "postinstall": "node scripts/ensure-haven-aol.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.7.0",
    "@base-org/account": "^2.5.9",
    "@filoz/synapse-sdk": "1.1.1",
    "@icp-sdk/core": "6.1.0",
    "@ipld/car": "5.4.7",
    "@ipld/dag-pb": "4.1.7",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@reown/appkit": "1.8.23",
    "@reown/appkit-adapter-wagmi": "1.8.23",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@wagmi/core": "3.6.4",
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.21.0",
    "@x402/svm": "^2.21.0",
    "accounts": "0.14.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ethers": "6.17.0",
    "hermes-parser": "^0.37.0",
    "idb": "8.0.3",
    "ipfs-unixfs": "13.0.0",
    "language-subtag-registry": "^0.4.2",
    "lucide-react": "1.29.0",
    "multiformats": "14.0.5",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "pino-pretty": "13.1.3",
    "porto": "0.2.37",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "viem": "2.55.11",
    "wagmi": "3.7.6",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@synthetixio/synpress": "4.1.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "eslint": "10.8.0",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "6.2.5",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.7.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "use-sync-external-store": "1.6.0"
  }
}
